# Copier ce fichier en .env puis remplir les valeurs
GEMINI_API_KEY=votre_cle_gemini

# Compte administrateur de secours (utile sans SQL Server, ex. Streamlit Cloud).
# Laisser vide pour désactiver ce compte.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mode démo (1 pour activer) : réunions fictives de demo/meetings_demo.json,
# email masqué. Pratique pour les captures d'écran. Vos vraies réunions ne sont pas touchées.
DEMO_MODE=
